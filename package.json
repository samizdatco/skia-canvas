{
  "name": "skia-canvas",
  "version": "3.0.8",
  "description": "A multi-threaded, GPU-accelerated, Canvas API for Node",
  "author": "Christian Swinehart <drafting@samizdat.co>",
  "license": "MIT",
  "homepage": "https://skia-canvas.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samizdatco/skia-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/samizdatco/skia-canvas/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    "node": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "browser": "./lib/browser.js",
    "types": "./lib/index.d.ts"
  },
  "scripts": {
    "build": "node lib/prebuild.mjs compile",
    "download": "node lib/prebuild.mjs download --or-compile",
    "upload": "node lib/prebuild.mjs upload",
    "test": "node --test tests/suite/*"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "follow-redirects": "^1.16.0",
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@types/node": "^24.13.3",
    "clean-stack": "^5.2.0",
    "hono": "^4.12.32",
    "jest-diff": "^29.7.0",
    "markdown-or-chalk": "^0.2.0",
    "nock": "^14.0.16",
    "tmp": "^0.2.7"
  },
  "engines": {"node": ">=18.18"},
  "files": [
    "lib/*js",
    "lib/*ts",
    "lib/classes/*js",
    "lib/fonts"
  ],
  "keywords": [
    "canvas",
    "gpu",
    "skia",
    "offscreen",
    "headless",
    "graphic",
    "graphics",
    "image",
    "images",
    "compositing",
    "render",
    "vulkan",
    "metal",
    "pdf",
    "svg",
    "rust"
  ],
  "volta": {
    "node": "24.18.0"
  }
}
